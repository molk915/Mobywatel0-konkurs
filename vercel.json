{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "regions": ["fra1"],
  "functions": {
    "api/dispatch.js": {
      "includeFiles": "src/**/*.ts"
    }
  },
  "rewrites": [
    {
      "source": "/api/:path(health|assistant|workflows)",
      "destination": "/api/dispatch?mostPath=:path"
    },
    {
      "source": "/api/:area(family|most|wellness|workflows)/:operation",
      "destination": "/api/dispatch?mostPath=:area/:operation"
    }
  ]
}
