{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "regions": ["fra1"],
  "rewrites": [
    {
      "source": "/api/:path(health|assistant)",
      "destination": "/api/dispatch?mostPath=:path"
    },
    {
      "source": "/api/:area(family|most|wellness|workflows)/:operation",
      "destination": "/api/dispatch?mostPath=:area/:operation"
    }
  ]
}
